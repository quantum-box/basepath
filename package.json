{
  "name": "pathbase",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/prepare-sites-build.mjs",
    "check": "tsc --noEmit",
    "tauri": "tauri",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src vite.config.mjs index.html src-tauri/tauri.conf.json",
    "dev:web": "vite",
    "dev:native": "node scripts/dev.mjs --native",
    "api": "cargo run --manifest-path api/Cargo.toml",
    "preflight": "node scripts/preflight.mjs",
    "api:mcp": "cargo run --manifest-path api/Cargo.toml -- --mcp-stdio",
    "test:api": "cargo test --manifest-path api/Cargo.toml",
    "test": "npm run check && npm run test:api && npm run test:sites"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "^5.2.6",
    "@fontsource/zen-kurenaido": "^5.2.6",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.11.1",
    "@vitejs/plugin-react": "5.0.4",
    "@xyflow/react": "^12.8.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "^2.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
