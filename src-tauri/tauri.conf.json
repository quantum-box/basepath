{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PathBase",
  "version": "0.1.0",
  "identifier": "io.pathbase.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [
      {
        "title": "PathBase",
        "width": 1672,
        "height": 941,
        "minWidth": 960,
        "minHeight": 700,
        "center": true,
        "backgroundColor": "#f7f9fc"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
