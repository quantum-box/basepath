# Local preview is explicit; production defaults to Tachyon authentication.
# npm run dev sets local-preview when PATHBASE_MODE is omitted.
PATHBASE_MODE=tachyon
PATHBASE_PUBLIC_URL=http://localhost:1420
TACHYON_OIDC_ISSUER=
TACHYON_OIDC_CLIENT_ID=
TACHYON_OIDC_CLIENT_SECRET=
TACHYON_OIDC_REDIRECT_URI=http://localhost:1420/api/auth/callback
TACHYON_API_URL=
# Field context comes from the existing Field deployment; do not use another user's service credential.
FIELD_API_URL=
FIELD_PLATFORM_ID=
FIELD_OPERATOR_ID=
PATHBASE_DB=data/pathbase.sqlite3
PATHBASE_API_PORT=1431
# Authenticated native app: use the same deployed web app and its Tachyon session.
# PATHBASE_WEB_URL=https://pathbase.example.com
