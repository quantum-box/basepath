# Local preview is explicit; production defaults to Tachyon authentication.
# npm run dev sets local-preview when PATHBASE_MODE is omitted.
PATHBASE_MODE=tachyon
PATHBASE_PUBLIC_URL=http://localhost:1420
TACHYON_OIDC_ISSUER=https://api.n1.tachy.one
# Public PKCE client declared in tachyon.yml; this identifier is not a secret.
TACHYON_OIDC_CLIENT_ID=3pa16qkbq47n62nsu257n829ba
TACHYON_OIDC_CLIENT_SECRET=
# Registered OAuth redirect used for server-to-server code exchange; the browser never opens it.
TACHYON_OIDC_REDIRECT_URI=http://localhost:1420/api/auth/callback
TACHYON_API_URL=https://api.n1.tachy.one
# Cognito user pool that issues the sign-in token (ADR-0036). Field delegates to
# Tachyon's Cognito verifier, which requires the bearer's issuer and signature to
# come from this pool, so a Tachyon-issued token is always rejected with 401.
# Registering the OAuth2Client with useTachyonUserPool also creates a secretless
# Cognito App Client with USER_PASSWORD_AUTH, so TACHYON_OIDC_CLIENT_ID above is
# already that App Client's id and only the issuer has to be set here. The user
# pool id and region are public configuration, not secrets.
PATHBASE_COGNITO_ISSUER=https://cognito-idp.ap-northeast-1.amazonaws.com/ap-northeast-1_8Ga4bK5M4
# Set only when pinning a different App Client than TACHYON_OIDC_CLIENT_ID.
# PATHBASE_COGNITO_CLIENT_ID=
# Production-only secret: one or more comma-separated, unpadded base64url keys,
# each exactly 32 random bytes. The first encrypts; the rest allow rolling rotation.
# Example generation: openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
PATHBASE_SESSION_KEYS=
# Field context comes from the existing Field deployment; do not use another user's service credential.
FIELD_API_URL=https://tachyon-field-api.txcloud.app
FIELD_PLATFORM_ID=tn_01hjjn348rn3t49zz6hvmfq67p
# Field's production tenant-directory root, not the PathBase operator tenant.
FIELD_OPERATOR_ID=tn_01j91h09tpj5ehwbwfwfxpak2b
# Production (PATHBASE_MODE != local-preview) requires a shared database.
# Tachyon provisions it from tachyon.yml's `provisionedDatabase` and injects
# the DSN as DATABASE_URL; never commit a real DSN here. There is no SQLite
# fallback: an unset or unreachable DATABASE_URL is a startup error.
#   DATABASE_URL=<issued by Tachyon>
#
# Which deployment a database belongs to. Declared per environment in
# tachyon.yml (production / preview). The first process to migrate claims the
# database for this value; a process configured for a different one refuses.
# PATHBASE_DB_ENVIRONMENT=production
#
# Connection pool and TLS (all optional; see docs/production-durability.md):
# PATHBASE_DB_MAX_CONNECTIONS=2
# PATHBASE_DB_CONNECT_TIMEOUT_SECS=10
# PATHBASE_DB_IDLE_TIMEOUT_SECS=300
# PATHBASE_DB_MAX_LIFETIME_SECS=600
# PATHBASE_DB_MIGRATION_LOCK_SECS=60
# PATHBASE_DB_SSL_MODE=preferred
#
# Local preview only. Ignored once DATABASE_URL is set.
PATHBASE_DB=data/pathbase.sqlite3
PATHBASE_API_PORT=1431
# Hosted MCP (Streamable HTTP). Setting the switch below turns the endpoint on;
# without it the endpoint does not exist, and there is no shared-secret mode.
# PathBase is the authorization server for its own MCP resource and issues the
# tokens: people still sign in against the Cognito pool, but the delegation to
# one AI client is PathBase's to grant and to revoke. See
# docs/mcp-authorization.md and docs/chatgpt-plugin.md.
# PATHBASE_MCP_ENABLED=1
# PATHBASE_MCP_RESOURCE=https://pathbase.example.com/api/mcp
# Where the Rust API is reachable from outside. Behind the Worker that is
# `{PATHBASE_PUBLIC_URL}/api`, which is the default; set it only when running
# the API directly on its own origin.
# PATHBASE_API_BASE_URL=https://pathbase.example.com/api
# PATHBASE_MCP_ALLOWED_HOSTS=pathbase.example.com
# Run `npm run preflight` before starting a live Tachyon deployment. The report
# never prints client secrets, tokens, or tenant identifiers.
# Authenticated native app: use the same deployed web app and its Tachyon session.
# PATHBASE_WEB_URL=https://pathbase.example.com
